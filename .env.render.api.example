# Render API service (start command: ./start.sh api). Names only; never commit values.
# Copy to .env.render.api (gitignored), fill in, then paste it into the service's
# Environment page with "Add from .env". Leave RENDER, VERA_PUBLIC_MODE and VERA_TRUST_PROXY unset.
OPENAI_API_KEY=
# Strong random key; the same value goes in .env.render.ui.
VERA_API_KEY=
# Optional, free-tier-first /ask (item #77): with this set, /ask is answered by Groq at $0 and falls back
# to OpenAI only when Groq fails. Providers and models: config/ask-provider-chain.json.
GROQ_API_KEY=
# Optional, only after adding an OpenRouter entry to config/ask-provider-chain.json (see its openrouter_example).
# OPENROUTER_API_KEY=
# Optional, corpus growth (item #79 phase C): connection URL of the production write-only account
# vera_pipeline_wo (use Render's INTERNAL database URL with that account). Unset = sources are not stored.
# VERA_DB_URL_WO=
# Optional, corpus description in the sidebar (item #83): Render's INTERNAL database URL with the read-only
# account vera_eval_ro. Unset = "description not available".
# VERA_DB_URL_RO=

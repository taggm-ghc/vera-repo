# Render UI service (Docker Command: ./start.sh ui). Names only; never commit values.
# Copy to .env.render.ui (gitignored), fill in, then paste it into the service's
# Environment page with "Add from .env". Leave RENDER, VERA_PUBLIC_MODE and VERA_TRUST_PROXY unset.
# Same value as VERA_API_KEY in .env.render.api.
VERA_API_KEY=
# The API service's https:// address, no trailing slash (known once the API service exists).
VERA_API_BASE_URL=
# No database on Render yet: demo pages show the labelled fixture.
VERA_DEMO_SOURCE=fixture

# Python virtual environment
.venv/
.venv.*/
venv/

# Environment variables / secrets: every .env file except the blank templates
.env
.env.*
!.env.example
!.env.render.*.example

# anti-pattern
anti-pattern/

# Syllabus / documentation (track but no secrets)
syllabus/

# Opencode CLI notes
opencode.cli/

# Byte-compiled / cache
__pycache__/
*.py[cod]

# Local server logs / scratch
*.log
.vera-local-url

# Windows "mark of the web" alternate-data-stream cruft (WSL)
*:Zone.Identifier

# Private / non-published material (anything marked *-prv)
*-prv.*
*-prv/

# Deprecated code kept for reference only — never shipped
deprecated/

# VERA slim live MVP runner: per-run reports and the register (never commit)
.vera-runs/

# Item #70 raw trace captures hold full arXiv abstracts; never committed.
tmp/trace_eval/
tmp/search_eval/
tmp/search_cache/
# Item #72 W1 scope-router measurements (per-item decisions); never committed.
tmp/scope_eval/

# Personal social posts (LinkedIn etc.), drafts or final, are never committed (R1, 2026-10-05).
*linkedin-post*
*linkedin*post*.md
*build-in-public-post*.md
*maven-post*.md
